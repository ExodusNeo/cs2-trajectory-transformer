# FACEIT Open Data API Key
# Register and generate your API key at: https://developers.faceit.com/
FACEIT_API_KEY=your_faceit_api_key_here

# RA 10173 Research Ethics & Cryptographic Pseudonymization Secret Salt
# Mandatory high-entropy secret salt used for one-way SHA-256 pseudonymization of SteamIDs and Match IDs.
CS2_PSEUDONYMIZATION_SALT=your_secure_secret_salt_here
